# Copy to .env and fill in real values. Never commit .env to git.

# --- Postgres ---
POSTGRES_USER=veritas
POSTGRES_PASSWORD=veritas_secret
POSTGRES_DB=veritas_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Valkey (Redis-compatible) ---
VALKEY_HOST=valkey
VALKEY_PORT=6379
VALKEY_PASSWORD=

# --- Qdrant ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=veritas_policies

# --- JWT ---
JWT_SECRET_KEY=change_me_to_a_long_random_string_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- LLM (LiteLLM router) ---
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
LLM_PRIMARY_MODEL=gemini/gemini-2.5-flash
LLM_FALLBACK_MODEL=openai/gpt-4o-mini

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
